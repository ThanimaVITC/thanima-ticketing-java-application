<?xml version="1.0" encoding="utf-8"?><!--
  A person rendered as their campus ID card, shared by the pool confirm step and the
  ticket verify result. A scan brings back no photo, so Rambo stands in the photo slot.
  Card ink is fixed dark-on-white in both themes: it is a printed card, not UI.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/id_card_bg"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="18dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:src="@drawable/vit_logo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:text="@string/id_campus"
            android:textColor="@color/id_card_ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="18dp">

            <!-- Where the photo would be. -->
            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginBottom="10dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_rambo" />

            <TextView
                android:id="@+id/tvIdName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/id_card_name"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="Adithyan P" />

            <TextView
                android:id="@+id/tvIdRegNo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:textColor="@color/id_card_ink"
                android:textSize="22sp"
                tools:text="24BCE1168" />

            <TextView
                android:id="@+id/tvIdPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/id_card_ink"
                android:textSize="16sp"
                tools:text="+91 98765 43210" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/id_card_band"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:paddingVertical="10dp"
            android:text="@string/id_footer"
            android:textColor="@color/id_card_band_text"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
