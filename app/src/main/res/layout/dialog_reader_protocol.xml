<?xml version="1.0" encoding="utf-8"?>
<!-- Shown the moment Bluetooth is chosen: pick the transport, with the board table right
     there so nobody has to guess whether their chip has a classic radio. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <RadioGroup
            android:id="@+id/protocolGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbSpp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reader_protocol_spp"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                android:layout_marginBottom="8dp"
                android:text="@string/reader_protocol_spp_sub"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbBle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reader_protocol_ble"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                android:text="@string/reader_protocol_ble_sub"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/reader_boards_title"
            style="@style/Text.SectionTitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.TableHead"
                android:layout_weight="2.4"
                android:text="@string/reader_board_column" />

            <TextView
                style="@style/Text.TableHead"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/reader_protocol_spp_short" />

            <TextView
                style="@style/Text.TableHead"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/reader_protocol_ble_short" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.TableCell"
                android:layout_weight="2.4"
                android:text="@string/reader_board_original" />

            <TextView
                style="@style/Text.TableCell"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/reader_yes" />

            <TextView
                style="@style/Text.TableCell"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/reader_yes" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.TableCell"
                android:layout_weight="2.4"
                android:text="@string/reader_board_s3" />

            <TextView
                style="@style/Text.TableCell"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/reader_no" />

            <TextView
                style="@style/Text.TableCell"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/reader_yes" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.TableCell"
                android:layout_weight="2.4"
                android:text="@string/reader_board_c3" />

            <TextView
                style="@style/Text.TableCell"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/reader_no" />

            <TextView
                style="@style/Text.TableCell"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/reader_yes" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.TableCell"
                android:layout_weight="2.4"
                android:text="@string/reader_board_s2" />

            <TextView
                style="@style/Text.TableCell"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/reader_no" />

            <TextView
                style="@style/Text.TableCell"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/reader_no" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/reader_board_note"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</ScrollView>
